#!/usr/bin/env ruby

require 'shellwords'

EMACS = 'emacs'
EMACSCLIENT = 'emacsclient'

RC_DIR = File.expand_path('..', File.dirname(__FILE__))
SERVERS_DIR = "#{RC_DIR}/servers"

class App
  def run(args)
    args = parse_args(args)

    ENV['G_START_DIR'] = Dir.pwd

    path = resolve_path(args.pop || '.')
    args = [*args, path].compact

    abs_path = File.expand_path(path)

    Dir["#{SERVERS_DIR}/server-*"].each do |server_path|
      pid = File.basename(server_path)[/\d+/]
      File.delete(server_path) if pid && !pid_live?(pid)
    end

    candidates =
      if path.nil?
        []
      else
        Dir["#{SERVERS_DIR}/server-*"].select do |server_path|
          pid = File.basename(server_path)[/\d+/]
          roots = File.readlines(server_path).map { |root| File.expand_path(root.chomp) }
          pid && roots.any? { |r| abs_path == r || abs_path.start_with?("#{r}/") }
        end
      end

    if candidates.empty?
      sh EMACS, '--debug-init', *args, background: true
    else
      sh EMACSCLIENT, '-n', '-s', File.basename(candidates[0]), *args
    end
  end

  def resolve_path(path)
    return nil if path.nil?
    return path if File.exist?(path)
    # Remove a/ or b/ prefix, because I often paste paths from git diffs.
    stripped = path.sub(%r'\A[ab]/', '')
    return stripped if File.exist?(stripped)
    # Diff paths are relative to the repo root, which may be an ancestor of the
    # current directory.
    root = git_root(Dir.pwd)
    if root
      candidate = File.join(root, stripped)
      return candidate if File.exist?(candidate)
    end
    stripped
  end

  def git_root(dir)
    loop do
      return dir if File.exist?(File.join(dir, '.git'))
      parent = File.dirname(dir)
      return nil if parent == dir
      dir = parent
    end
  end

  def parse_args(args)
    result = []
    args.each do |arg|
      if arg.start_with?('+')
        result << arg
      elsif arg =~ /\A(.+):(\d+)\z/
        result << "+#$2" << $1
      else
        result << arg
      end
    end
    return result
  end

  def pid_live?(pid)
    Process.kill(0, pid.to_i)
    true
  rescue Errno::ESRCH
    false
  rescue Errno::EPERM
    true
  end

  def sh(*command, background: false)
    STDERR.puts "++ #{command.shelljoin}#{' &' if background}"
    if background
      process = fork do
        exec *command
      end
      Process.detach(process)
    else
      system *command
    end
  end
end

App.new.run(ARGV)
